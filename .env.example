# Gateway OpenCode (endpoint OpenAI-compatible que traduce a Claude/GPT/Gemini/...)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
# Cualquier id de modelo del gateway: claude-sonnet-5-5, claude-haiku-5-5, gpt-5.4-mini, ...
MODEL=claude-sonnet-5-5
# Firma HMAC de las aprobaciones humanas (evita que un cliente falsifique un "aprobado")
TOOL_APPROVAL_SECRET=cambia-esto-por-un-valor-aleatorio-largo
# Carpeta con maestros/ y solicitudes/ del reto
FIXTURES_DIR=fixtures/reto-03
PORT=3000
