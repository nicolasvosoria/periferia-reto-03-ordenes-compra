# Gateway OpenCode, endpoint OpenAI-compatible (chat/completions)
OPENCODE_API_KEY=
# Suscripción Go:              https://opencode.ai/inference/go/openai/v1
# Zen/Console (pago por uso):  https://opencode.ai/inference/openai/v1
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
# Id del modelo según el catálogo del endpoint (GET <base>/models)
MODEL=deepseek-v4.1-flash
PORT=3000
# Topes de costo (opcionales): pasos herramienta→modelo por turno, tokens por sesión, turnos de chat por día
MAX_PASOS=25
MAX_TOKENS_SESION=300000
MAX_TURNOS_DIARIOS=500
# Carga de documentos desde el chat (.json/.txt). Por defecto: apagada en producción, encendida en local
UPLOAD_ENABLED=
